#!/usr/bin/env python3
"""Import a state saved by upstream GRASP rsave into the current directory."""

import argparse
import os
import re
import shutil
import signal
import subprocess
from pathlib import Path
from tempfile import TemporaryDirectory
from types import FrameType


def present(path: Path) -> bool:
    return path.exists() or path.is_symlink()


def require_data(path: Path) -> None:
    if not path.is_file() or path.stat().st_size == 0:
        raise ValueError(f"missing or empty file: {path.name}")


def import_state(state: str, rcsfs_command: str) -> None:
    directory = Path.cwd()
    csfs = directory / f"{state}.c"
    wavefunction = directory / f"{state}.w"
    require_data(csfs)
    require_data(wavefunction)

    summary = directory / f"{state}.sum"
    average_level = False
    if summary.is_file():
        with summary.open(encoding="utf-8", errors="replace") as lines:
            average_level = any(line.split() == ["(E)AL", "calculation."] for line in lines)

    copies = {wavefunction: f"{state}.wfn"}
    for old_suffix, new_suffix in (
        (".m", ".mix"),
        (".cm", ".cimix"),
        (".sum", ".rmcdhf.summary"),
        (".log", ".rmcdhf.log"),
        (".alog", ".rangular.log"),
    ):
        source = directory / f"{state}{old_suffix}"
        if (old_suffix == ".m" and average_level) or not present(source):
            continue
        if not source.is_file():
            raise ValueError(f"not a regular file: {source.name}")
        if old_suffix in {".m", ".cm"}:
            require_data(source)
        copies[source] = f"{state}{new_suffix}"

    header = f"{state}_header.toml"
    descriptors = f"{state}_desc.parquet"
    # Publish the descriptor last so consumers never see it without the header.
    filenames = [*copies.values(), header, descriptors]
    for filename in filenames:
        if present(directory / filename):
            raise ValueError(f"destination already exists: {filename}")

    executable = shutil.which(rcsfs_command)
    if executable is None:
        raise ValueError(f"cannot find a V3-capable rcsfs executable: {rcsfs_command}")

    with TemporaryDirectory(prefix=".import_rsave.", dir=directory) as temporary:
        staging = Path(temporary)
        subprocess.run(
            [str(Path(executable).resolve()), "convert", "--", str(csfs), descriptors],
            cwd=staging,
            check=True,
        )
        require_data(staging / descriptors)
        require_data(staging / header)
        with (staging / header).open("rb") as stream:
            if re.fullmatch(rb'descriptor_sha256 = "[0-9a-f]{64}"\n', stream.readline(128)) is None:
                raise ValueError("rcsfs did not write a bound V3 descriptor header")
        for source, filename in copies.items():
            shutil.copy2(source, staging / filename)

        try:
            for filename in filenames:
                (directory / filename).hardlink_to(staging / filename)
        except BaseException:
            # Roll back only files linked from this staging directory. A concurrent
            # import or an existing result owns a different inode.
            for filename in reversed(filenames):
                destination = directory / filename
                try:
                    if not destination.is_symlink() and destination.samefile(staging / filename):
                        destination.unlink()
                except FileNotFoundError:
                    pass
            raise

    print(f"Imported {state}: {', '.join(filenames)}")


def terminate(signum: int, _frame: FrameType | None) -> None:
    raise SystemExit(128 + signum)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("state", metavar="STATE", help="filename stem passed to rsave")
    parser.add_argument("--rcsfs", default="rcsfs", help="V3-capable rcsfs executable")
    args = parser.parse_args()
    if (
        args.state in {"", ".", ".."}
        or len(os.fsencode(args.state)) > 127
        or any(character.isspace() or character in "/\\" for character in args.state)
    ):
        parser.error("use a state name of at most 127 bytes without directories or spaces")
    signal.signal(signal.SIGTERM, terminate)
    try:
        import_state(args.state, args.rcsfs)
    except subprocess.CalledProcessError as error:
        parser.exit(1, f"{parser.prog}: rcsfs convert failed (exit {error.returncode})\n")
    except (OSError, ValueError) as error:
        parser.exit(1, f"{parser.prog}: {error}\n")


if __name__ == "__main__":
    main()
