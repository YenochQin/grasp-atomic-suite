# Collect the actual configured tree, including tests, after every subdirectory.
option(GRASP_CAPTURE_WARNINGS "Record per-compilation GNU Fortran diagnostics" ${GRASP_STRICT_ACCEPTANCE})
if(GRASP_CAPTURE_WARNINGS)
    # The test subdirectory's discovery variables are scoped to that directory.
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
endif()
function(grasp_acceptance_directory directory)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        get_target_property(type ${target} TYPE)
        if(type MATCHES "^(EXECUTABLE|STATIC_LIBRARY|OBJECT_LIBRARY|SHARED_LIBRARY)$")
            get_target_property(modules ${target} Fortran_MODULE_DIRECTORY)
            if(NOT modules)
                set(modules "${Fortran_MODULE_DIRECTORY_root}/${target}")
                set_property(TARGET ${target} PROPERTY Fortran_MODULE_DIRECTORY "${modules}")
            endif()
            target_include_directories(${target} BEFORE PRIVATE "${modules}")
            file(MAKE_DIRECTORY "${modules}")
            if(GRASP_CAPTURE_WARNINGS)
                get_target_property(existing_launcher ${target} Fortran_COMPILER_LAUNCHER)
                set(warning_launcher "${Python3_EXECUTABLE}"
                    "${PROJECT_SOURCE_DIR}/test/f2018/warning_inventory.py" capture
                    --source "${PROJECT_SOURCE_DIR}" --build "${PROJECT_BINARY_DIR}"
                    --compiler "${CMAKE_Fortran_COMPILER}" --)
                if(existing_launcher)
                    list(APPEND warning_launcher ${existing_launcher})
                endif()
                set_property(TARGET ${target} PROPERTY Fortran_COMPILER_LAUNCHER "${warning_launcher}")
            endif()
            set_property(GLOBAL APPEND PROPERTY GRASP_ACCEPTANCE_TARGETS ${target})
        endif()
    endforeach()
    get_property(tests DIRECTORY "${directory}" PROPERTY TESTS)
    set_property(GLOBAL APPEND PROPERTY GRASP_ACCEPTANCE_TESTS ${tests})
    foreach(test IN LISTS tests)
        set(labels f2018_unit)
        if(test MATCHES "(^|_)mpi(_|$)|broadcast|consumers_rmcdhf.*mpi")
            list(APPEND labels f2018_mpi)
        else()
            list(APPEND labels f2018_serial)
        endif()
        if(test MATCHES "rdensity|jj2lsj|gj90|ris")
            list(APPEND labels f2018_properties)
        endif()
        if(test MATCHES "restart|file|output|paths|sweep")
            list(APPEND labels f2018_io)
        endif()
        # No f2018_real_case label until a real-case fixture is implemented.
        set_property(TEST ${test} DIRECTORY "${directory}" APPEND PROPERTY LABELS ${labels})
        if(NOT test MATCHES "^jj2lsj_")
            set_property(TEST ${test} DIRECTORY "${directory}" APPEND PROPERTY ENVIRONMENT
                "OMP_NUM_THREADS=1" "OPENBLAS_NUM_THREADS=1" "MKL_DYNAMIC=FALSE")
        endif()
    endforeach()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        grasp_acceptance_directory("${child}")
    endforeach()
endfunction()
grasp_acceptance_directory("${PROJECT_SOURCE_DIR}")
get_property(targets GLOBAL PROPERTY GRASP_ACCEPTANCE_TARGETS)
list(SORT targets)
string(REPLACE ";" "\n" target_lines "${targets}")
file(WRITE "${PROJECT_BINARY_DIR}/f2018-targets.txt" "${target_lines}\n")
get_property(tests GLOBAL PROPERTY GRASP_ACCEPTANCE_TESTS)
string(REPLACE ";" "\n" test_lines "${tests}")
file(WRITE "${PROJECT_BINARY_DIR}/f2018-tests.txt" "${test_lines}\n")
set(features "")
if(GRASP_BUILD_SERIAL_APPS)
    list(APPEND features serial)
endif()
if(TARGET mpiu90)
    list(APPEND features mpi)
endif()
if(GRASP_BUILD_CSFG)
    list(APPEND features csfg)
endif()
string(JOIN "," feature_argument ${features})
get_target_property(grasp_openmp jj2lsj_conversion JJ2LSJ_OPENMP)
file(GENERATE OUTPUT "${PROJECT_BINARY_DIR}/f2018-features.json" CONTENT
    "{\"profile\":\"${GRASP_FORTRAN_PROFILE}\",\"serial\":$<BOOL:${GRASP_BUILD_SERIAL_APPS}>,\"mpi\":$<TARGET_EXISTS:mpiu90>,\"csfg\":$<BOOL:${GRASP_BUILD_CSFG}>,\"openmp\":$<BOOL:${grasp_openmp}>}\n")
if(GRASP_STRICT_ACCEPTANCE)
    if(GRASP_ENABLE_MPI AND (NOT MPIEXEC_EXECUTABLE OR NOT MPIEXEC_NUMPROC_FLAG))
        message(FATAL_ERROR "Strict MPI validation requires an MPI launcher and rank flag")
    endif()
    if(GRASP_JJ2LSJ_OPENMP AND NOT grasp_openmp)
        message(FATAL_ERROR "Strict OpenMP validation cannot substitute a serial backend")
    endif()
    execute_process(COMMAND "${Python3_EXECUTABLE}"
        "${PROJECT_SOURCE_DIR}/test/f2018/check.py" --check-config
        "${PROJECT_BINARY_DIR}" --features "${feature_argument}"
        RESULT_VARIABLE acceptance_config_status)
    if(NOT acceptance_config_status EQUAL 0)
        message(FATAL_ERROR "F2018 acceptance configuration is incomplete")
    endif()
endif()
