# Production optimization and validation diagnostics are separate concerns.
set(default_fortran_profile "f2018-release")
if(CMAKE_BUILD_TYPE STREQUAL "Debug")
    set(default_fortran_profile "f2018-check")
endif()
set(GRASP_FORTRAN_PROFILE "${default_fortran_profile}" CACHE STRING "Fortran build profile")
set_property(CACHE GRASP_FORTRAN_PROFILE PROPERTY STRINGS f2018-release f2018-check f2018-audit)
if(NOT GRASP_FORTRAN_PROFILE MATCHES "^f2018-(check|audit|release)$")
    message(FATAL_ERROR "Unsupported/retired profile ${GRASP_FORTRAN_PROFILE}; use f2018-release, f2018-check or f2018-audit")
endif()
if(NOT CMAKE_Fortran_COMPILER_ID STREQUAL "GNU" OR
   NOT CMAKE_Fortran_COMPILER_VERSION VERSION_GREATER_EQUAL 15 OR
   CMAKE_Fortran_COMPILER_VERSION VERSION_GREATER_EQUAL 16)
    message(FATAL_ERROR "The supported toolchain is GNU Fortran 15.x; use a fresh build directory.")
endif()
string(CONCAT supplied_flags "${CMAKE_Fortran_FLAGS} "
    "${CMAKE_Fortran_FLAGS_DEBUG} ${CMAKE_Fortran_FLAGS_RELEASE}")
if(supplied_flags MATCHES "-f(no-automatic|allow-argument-mismatch|all-intrinsics|default-(integer|real|double)-[0-9]+|fast-math)|-Ofast|-std=(legacy|gnu)")
    message(FATAL_ERROR "Compatibility, implicit SAVE and unsafe numeric flags are not supported: ${supplied_flags}")
endif()
set(CMAKE_EXPORT_COMPILE_COMMANDS ON CACHE BOOL "Record actual compiler commands" FORCE)
set(GRASP_STRICT_ACCEPTANCE ON)
set(GRASP_DIAGNOSTIC_BUILD OFF)
if(GRASP_FORTRAN_PROFILE STREQUAL "f2018-release")
    if(NOT CMAKE_BUILD_TYPE STREQUAL "Release")
        message(FATAL_ERROR "f2018-release requires -DCMAKE_BUILD_TYPE=Release")
    endif()
    set(CMAKE_Fortran_FLAGS_RELEASE "-O2")
else()
    set(GRASP_DIAGNOSTIC_BUILD ON)
    set(CMAKE_Fortran_FLAGS "${CMAKE_Fortran_FLAGS} -std=f2018 -pedantic-errors -Wall -Wextra -Werror=implicit-interface -Werror=implicit-procedure")
    if(GRASP_FORTRAN_PROFILE STREQUAL "f2018-check")
        if(NOT CMAKE_BUILD_TYPE STREQUAL "Debug")
            message(FATAL_ERROR "f2018-check requires -DCMAKE_BUILD_TYPE=Debug")
        endif()
        set(CMAKE_Fortran_FLAGS_DEBUG "-O0 -g -fcheck=all -fbacktrace -ffpe-trap=invalid,zero,overflow")
    else()
        if(NOT CMAKE_BUILD_TYPE STREQUAL "Release")
            message(FATAL_ERROR "f2018-audit is an optimized diagnostic build; use -DCMAKE_BUILD_TYPE=Release")
        endif()
        set(CMAKE_Fortran_FLAGS_RELEASE "-O2")
    endif()
endif()
message(STATUS "Fortran profile: ${GRASP_FORTRAN_PROFILE}; diagnostic flags: ${GRASP_DIAGNOSTIC_BUILD}")
