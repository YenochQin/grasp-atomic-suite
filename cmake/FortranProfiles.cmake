# The audit profile retains legacy storage while making its limits explicit.
set(GRASP_FORTRAN_PROFILE "f2018-audit" CACHE STRING "Fortran migration profile")
set_property(CACHE GRASP_FORTRAN_PROFILE PROPERTY STRINGS legacy f2018-audit f2018-check f2018-release)
if(NOT GRASP_FORTRAN_PROFILE MATCHES "^(legacy|f2018-audit|f2018-check|f2018-release)$")
    message(FATAL_ERROR "Unknown GRASP_FORTRAN_PROFILE=${GRASP_FORTRAN_PROFILE}")
endif()
if(NOT CMAKE_Fortran_COMPILER_ID STREQUAL "GNU" OR
   NOT CMAKE_Fortran_COMPILER_VERSION VERSION_GREATER_EQUAL 15 OR
   CMAKE_Fortran_COMPILER_VERSION VERSION_GREATER_EQUAL 16)
    message(FATAL_ERROR "The migration profiles require GNU Fortran 15.x; use a fresh build directory.")
endif()
set(CMAKE_EXPORT_COMPILE_COMMANDS ON CACHE BOOL "Record actual compiler commands" FORCE)
set(GRASP_STRICT_ACCEPTANCE OFF)
if(GRASP_FORTRAN_PROFILE MATCHES "^f2018-(check|release)$")
    set(GRASP_STRICT_ACCEPTANCE ON)
    string(CONCAT supplied_flags "${CMAKE_Fortran_FLAGS} "
        "${CMAKE_Fortran_FLAGS_DEBUG} ${CMAKE_Fortran_FLAGS_RELEASE}")
    if(supplied_flags MATCHES "-f(no-automatic|allow-argument-mismatch|all-intrinsics|default-(integer|real|double)-[0-9]+|fast-math)|-Ofast|-std=(legacy|gnu)")
        message(FATAL_ERROR "Strict profiles reject compatibility, implicit storage and unsafe numeric flags: ${supplied_flags}")
    endif()
    set(CMAKE_Fortran_FLAGS "${CMAKE_Fortran_FLAGS} -std=f2018 -pedantic-errors -Wall -Wextra -Werror=implicit-interface -Werror=implicit-procedure -fno-fast-math -ffp-contract=off")
    if(GRASP_FORTRAN_PROFILE STREQUAL "f2018-check")
        if(NOT CMAKE_BUILD_TYPE STREQUAL "Debug")
            message(FATAL_ERROR "f2018-check requires -DCMAKE_BUILD_TYPE=Debug")
        endif()
        set(CMAKE_Fortran_FLAGS_DEBUG "-O0 -g -fcheck=all -fbacktrace -ffpe-trap=invalid,zero,overflow")
    else()
        if(NOT CMAKE_BUILD_TYPE STREQUAL "Release")
            message(FATAL_ERROR "f2018-release requires -DCMAKE_BUILD_TYPE=Release")
        endif()
        set(CMAKE_Fortran_FLAGS_RELEASE "-O2")
    endif()
elseif(GRASP_FORTRAN_PROFILE STREQUAL "legacy")
    set(CMAKE_Fortran_FLAGS "${CMAKE_Fortran_FLAGS} -std=legacy -fno-automatic")
else()
    set(CMAKE_Fortran_FLAGS "${CMAKE_Fortran_FLAGS} -std=f2018 -fno-automatic")
endif()
message(STATUS "Fortran profile: ${GRASP_FORTRAN_PROFILE}; strict acceptance: ${GRASP_STRICT_ACCEPTANCE}")
