.SUFFIXES: .f90 .mod

FC = gfortran                                                        # Fortran compiler
FC_FLAGS = -O2 -fno-automatic                                        # Serial code compiler flags
LAPACK_LIBS = -llapack -lblas                                        # Lapack libraries

# Location of the 2018 root directory
GRASP = /Users/wenxianli/Documents/Coding/grasp2018_master_git_F95

EXE = rtransition_phase
BINDIR = ${GRASP}/bin
GRASPLIB = ${GRASP}/lib
BINFILE = $(BINDIR)/$(EXE)
SRCLIBDIR = ${GRASP}/src/lib
MODDIR = ${SRCLIBDIR}/grasp_shared
MODL92 = ${SRCLIBDIR}/core
MODL_SPIN_ANGULAR = ${SRCLIBDIR}/spin_angular
MODL_BREIT_ANGULAR_SUPPORT = ${SRCLIBDIR}/breit_angular_support
GRASPLIBS =-l9290 -lgrasp_shared -lrang90 -lbreit_angular_support -ldvd90

APP_LIBS = -L${GRASPLIB} ${GRASPLIBS}

APP_OBJ= \
	             \
	            \
	               \
	              \
	     lodcslm_I.o      \
	           \
	             load_csf_basis_data_interface.o\
	         setcslm_I.o\
\
	rtransition_main.o read_state_filenames.o load_initial_transition_basis.o load_final_transition_basis.o lodcslm.o merge_transition_basis_records.o merge_transition_csf_bases.o \
         read_transition_mixing_coefficients.o right_csf_subshell_occupation.o right_csf_parity.o right_csf_two_j_plus_one.o right_csf_intermediate_coupling.o right_csf_subshell_quantum_number.o read_initial_radial_wavefunctions.o \
         read_final_radial_wavefunctions.o read_transition_options.o calculate_biorthogonal_overlap.o read_multipole_options.o write_input_summary.o calculate_oscillator_strengths.o map_merged_orbitals.o \
         resize_transition_matrix_arrays.o resize_transition_integral_arrays.o  read_transition_angular_coefficients.o write_transition_csf_weights.o write_transition_probability.o single_particle_transition_element.o check_transition_mixing_coefficients.o sort_transition_angular_coefficients.o \
         build_transition_bessel_functions.o resize_transition_label_arrays.o resize_transition_coefficient_arrays.o setcslm.o open_transition_angular_cache.o write_transition_level_energies.o write_transition_angular_coefficients.o \
	load_initial_lsj_labels.o load_final_lsj_labels.o write_lsj_transition_probability.o

$(EXE): $(APP_OBJ)
	$(FC) -o $(BINFILE) $(FC_LD) $(APP_OBJ) $(APP_LIBS) \
		$(APP_LIBS) ${LAPACK_LIBS}

.f90.o:
	$(FC) -c $(FC_FLAGS) $< -I $(MODDIR) -I . -I ${MODL92} -I ${MODL_SPIN_ANGULAR} -I $(MODL_BREIT_ANGULAR_SUPPORT) -o $@

.f.o:
	$(F90) -c $(FC_FLAGS) $< -o $@

clean:
	-rm -f *.o core *.mod

