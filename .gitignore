# Ignore compiler and installed build artifacts
*.o
*.mod
/bin/*
!/bin/.gitkeep
/lib/*
!/lib/.gitkeep

# Ignore user CMake configuration files
CMakeLists.user

# Local radial-grid patch settings (beside patch_grasp_grid.py)
config.toml

# Ignore generated CMake files
build/
build-*/

# Ignore Doxygen-generated files
/doc/html

# Ignore output log files
*.out
*.err


# mac file system
.DS_Store
*/.DS_Store

# Orbital optimization tests keep large calculation datasets outside the repo.
/test/data/
__pycache__/
*.py[cod]
