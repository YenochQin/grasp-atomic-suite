# Ignore compiler and installed build artifacts
*.o
*.mod
/bin/*
!/bin/.gitkeep
/lib/*
!/lib/.gitkeep

# Ignore user CMake configuration files
CMakeLists.user

# Ignore generated CMake files
build/
build-*/

# Ignore Doxygen-generated files
/doc/html

# Ignore output log files
*.out
*.err


# mac file system
.DS_Store/
